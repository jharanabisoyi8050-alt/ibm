DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/road_accident_db
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256

# IBM watsonx
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# AWS Bedrock
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Google Vertex AI (Gemini)
GEMINI_CREDENTIALS=base64_encoded_service_account_json
GCP_PROJECT_ID=your_gcp_project_id

# Optional: AWS Bedrock guardrail ID
BEDROCK_GUARDRAIL_ID=your_guardrail_id

# OpenWeatherMap
OPENWEATHERMAP_API_KEY=your_openweathermap_key

# LangSmith observability
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=road-accident-ai

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# MCP Server
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=9000

# Use simulated data (set to False when real live feeds are available)
SIMULATION_MODE=True

# Debug
DEBUG=False
